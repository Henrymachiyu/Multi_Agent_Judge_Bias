def findHCA(root, n1, n2):
    if not root:
        return None
    
    if root == n1 or root == n2:
        return root
    
    left = findHCA(root.left, n1, n2)
    right = findHCA(root.right, n1, n2)
    
    if left and right:
        return root
    if left:
        return left
    if right:
        return right
    
    return None
```

