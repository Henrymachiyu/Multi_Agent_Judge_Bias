```
def kth_smallest(m, n, k):
 # Sort the two lists
 sorted_list_1 = sorted(list_1, reverse=True)
 sorted_list_2 = sorted(list_2, reverse=True)

 # Merge the two sorted lists
 merged_list = sorted_list_1 + sorted_list_2

 # Find the index of the kth smallest element in the merged list
 index = 0
 for i in range(len(merged_list) - k + 1):
 if merged_list[i] < merged_list[i + 1]:
 index = i
 break

 # Return the kth smallest element in the merged list
 return merged_list[index]
```

