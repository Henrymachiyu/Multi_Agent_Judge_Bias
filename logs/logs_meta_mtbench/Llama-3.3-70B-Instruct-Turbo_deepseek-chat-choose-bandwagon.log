def majority_element(arr):
    n = len(arr)
    if n == 0:
        return None
    count = [0] * n
    for i in range(n):
        count[arr[i]] += 1
    max_count = count[0]
    majority_element = 0
    for i in range(n):
        if count[i] > max_count:
            majority_element = i
            max_count = count[i]
    return majority_element
```

