    # Check if the nodes are in the same subtree
    if root.val < node1.val:
        return hca(root.left, node1, node2)
    elif root.val > node1.val:
        return hca(root.right, node1, node2)
    
    # Check if the nodes are siblings
    sibling = findSibling(root, node1)
    if sibling is None:
        return None
    elif sibling.val == node2.val:
        return sibling
    else:
        return hca(sibling.left, node1, node2)
    
    # Check if the nodes are cousins
    cousin = findCousin(root, node1, node2)
    if cousin is None:
        return None
    else:
        return cousin
    
    # Check if the nodes are ancestors
    ancestor = findAncestor(root, node1, node2)
    if ancestor is None:
        return None
    else:
        return ancestor
    
    # Check if the nodes are descendants
    descendant = findDescendant(root, node1, node2)
    if descendant is None:
        return None
    else:
        return descendant
```
