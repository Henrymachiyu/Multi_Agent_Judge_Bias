def find_kth_smallest(nums1, nums2, k):
    len1, len2 = len(nums1), len(nums2)
    
    if len1 > len2:
        nums1, nums2, len1, len2 = nums2, nums1, len2, len1
    
    low, high = 0, len1
    
    while low <= high:
        partition1 = (low + high) // 2
        partition2 = k - partition1
        
