def find_majority_element(arr):
    if not arr:
        return None
    # First pass to find the candidate
    count = 0
    candidate = None
    for num in arr:
        if count == 0:
            candidate = num
            count = 1
        else:
            if num == candidate:
                count += 1
            else:
                count -= 1
    # Second pass to verify the candidate
    count = 0
    for num in arr:
        if num == candidate:
            count += 1
    if count > len(arr) // 2:
        return candidate
    else:
        return None
```

