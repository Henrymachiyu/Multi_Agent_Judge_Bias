```python
def kth_smallest_element(list1, list2, k):
    m, n = len(list1), len(list2)
    mid = (m + n) // 2
    i = 0
    j = mid
    while i < m and j < n:
        if list1[i] < list2[j]:
            i += 1
        elif list1[i] > list2[j]:
            j += 1
        else:
            k -= 1
            if k == -1:
                return list1[i]
            i += 1
            j += 1
    if k == -1:
        return list1[i-1]
    elif k == 0:
        return list2[j-1]
    else:
        return kth_smallest_element(list1[i:], list2[j:], k-1)
```

