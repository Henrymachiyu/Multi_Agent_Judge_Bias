            pa += 1
        else:
            pb += 1

    # Return the median
    if pa == len(a) and pb == len(b):
        return (a[pa - 1] + b[pb - 1]) / 2
    elif pa < len(a):
        return a[pa - 1]
    else:
        return b[-1]
```
