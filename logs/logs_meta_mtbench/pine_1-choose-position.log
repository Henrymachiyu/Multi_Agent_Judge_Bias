        ancestor_right = find_ancestor(common_ancestor, max_right, right)
        return ancestor_left, ancestor_right
    # If the left and right nodes are not the root, then the left and right
    # nodes are not the highest common ancestor, so we cannot find the HCA.
    # Return None.
