def find_ancestor(root, left, right):
    if left is None:
        return None
    if right is None:
        return None
    max_left = max(left, root)
    max_right = max(right, root)
    if max_left is None:
        return None
    if max_right is None:
        return None
    if left is not None and right is not None:
        # Find the common ancestor of the left and right nodes
        common_ancestor = find_ancestor(left, max_left, right)
        # Find the common ancestor of the left and right nodes
