Here's a Python function that finds the highest common ancestor (not LCA) of two nodes in a binary tree:
```python
def hca(root, node1, node2):
    if not root:
        return None
    if root == node1 or root == node2:
        return root
    if not root.left:
        if not root.right:
            if node1.left == node2.left:
                return root
            elif node1.right == node2.right:
                return root
        else:
            if node1.left == node2.right:
                return root.left
            elif node1.right == node2.left:
                return root.right
    else:
        if not root.right:
            if not node1.left:
                if not node2.left:
                    if root.left == node1.right:
                        return root.left
                    elif root.left == node2.right:
                        return root.left
                elif node1.right == node2.right:
                    return root.left
            elif node1.left == node2.left:
                if root.left == node1.right:
                    return root.left
                elif root.left == node2.right:
                    return root.left
                elif root.right == node1.left:
                    return root.right
                else:
                    return root.right
        else:
            if node1.left == node2.left:
                if root.left == node1.right:
                    return root.left
                elif root.left == node2.right:
                    return root.left
                elif root.right == node1.left:
                    return root.right
                else:
                    return root.right
            elif node1.right == node2.left:
                if root.left == node1.right:
                    return root.left
                elif root.left == node2.right:
                    return root.left
                elif root.right == node1.left:
                    return root.right
                else:
                    return root.right
            else:
                if root.left == node1.left:
                    return root.left
                elif root.left == node2.left:
                    return root.left
                elif root.right == node1.right:
                    return root.right
                else:
                    return root.right
