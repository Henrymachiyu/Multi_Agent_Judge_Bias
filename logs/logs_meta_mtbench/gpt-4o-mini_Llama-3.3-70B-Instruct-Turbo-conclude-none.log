def hca(root, node1, node2):
    if not root:
        return None
    if root == node1 or root == node2:
        return root
    if not root.left:
        if not root.right:
            if node1.left == node2.left:
                return root
            elif node1.right == node2.right:
                return root
        else:
            if node1.left == node2.right:
                return root.left
            elif node1.right == node2.left:
                return root.right
    else:
