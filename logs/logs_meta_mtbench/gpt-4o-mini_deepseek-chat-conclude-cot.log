```python
def full_binary_trees(n):
    if n % 2 == 0:
        return 0  # No full binary trees with an even number of vertices
    if n == 0:
        return 1  # The empty tree
    if n == 1:
        return 1  # A single node tree

    # Create a list to store the number of full binary trees for each number of vertices
    B = [0] * (n + 1)
    B[0] = 1  # Base case for empty tree
    B[1] = 1  # Base case for single node tree

    for i in range(3, n + 1, 2):  # Only odd numbers
        for j in range(0, i - 1, 2):  # Split into left and right subtrees
            B[i] += B[j] * B[i - 2 - j]

    return B[n]
```

