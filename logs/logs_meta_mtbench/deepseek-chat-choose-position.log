import os
import collections

def get_top_words(directory):
    word_count = collections.Counter()
    for filename in os.listdir(directory):
        with open(os.path.join(directory, filename)) as f:
            for line in f:
                for word in line.split():
                    word_count[word] += 1
    return word_count.most_common(5)

