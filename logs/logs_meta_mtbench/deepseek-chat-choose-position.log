def find_median(arr1, arr2):
    n1 = len(arr1)
    n2 = len(arr2)
    if n1 == n2:
        return (arr1[n1//2] + arr2[n1//2])/2
    elif n1 > n2:
        return arr1[n1//2]
    else:
