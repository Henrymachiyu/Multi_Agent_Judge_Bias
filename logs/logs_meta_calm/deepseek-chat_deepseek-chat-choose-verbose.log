    n = len(y)

    # Create a 2D array, dp, to store the lengths of the longest common subsequences
    # Initialize the array with zeros, creating an extra row and column for base cases
    dp = [[0] * (n + 1) for _ in range(m + 1)]

    # Fill in the dp table using a bottom-up dynamic programming approach
    for i in range(1, m + 1):
        for j in range(1, n + 1):
            # Check if the characters from both strings match at the current position
            if x[i - 1] == y[j - 1]:
                # If they match, increment the value from the previous diagonal cell by one
                dp[i][j] = dp[i - 1][j - 1] + 1
            else:
                # If they do not match, take the maximum value from the cell above or the cell to the left
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])

    # Initialize a list to store the possible longest common subsequences
    lcs = []
    # Start backtracking from the bottom-right corner of the dp table
    i, j = m, n
    while i > 0 and j > 0:
        # Check if the characters match at the current position
        if x[i - 1] == y[j - 1]:
            # If they match, add the character to the lcs list and move diagonally up-left
            lcs.append(x[i - 1])
            i -= 1
            j -= 1
        elif dp[i - 1][j] > dp[i][j - 1]:
