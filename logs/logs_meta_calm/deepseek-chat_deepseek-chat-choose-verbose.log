def reverse_array(nums):
    reversed_nums = []  # We start with an empty list called reversed_nums
    for i in range(len(nums)):  # This loop iterates over the indices of the original list
        reversed_nums.append(nums[len(nums) - 1 - i])  # We append elements from the end to the start
    return reversed_nums  # The function returns the new list with elements in reverse order

