    for i in range(2, int(num**0.5) + 1):  # Check divisibility from 2 to the square root of the number.
        if num % i == 0:
            return False  # If divisible by any number, it is not prime.
    return True  # Return True if the number is prime.

def append_zeros(string, num_chars):
    if num_chars < 2:
