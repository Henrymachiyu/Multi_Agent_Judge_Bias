Here is an implementation of a breadth-first search (BFS) algorithm in Python with a space complexity of O(n) and a time complexity of O(V+E):

```python
class Graph:
    def __init__(self, vertices):
        self.V = vertices
        self.adj = [[] for _ in range(vertices)]

    def add_edge(self, u, v):
        self.adj[u].append(v)

    def bfs(self, s, d):
        visited = [False] * self.V
        queue = []
        visited[s] = True
        queue.append(s)

        while queue:
            s = queue.pop(0)
            if s == d:
                return True
            for i in self.adj[s]:
                if not visited[i]:
                    visited[i] = True
                    queue.append(i)

        return False

# Example usage:
g = Graph(5)
g.add_edge(0, 1)
g.add_edge(0, 2)
g.add_edge(1, 2)
g.add_edge(2, 0)
g.add_edge(2, 3)
g.add_edge(3, 4)

print(g.bfs(2, 4))  # True
