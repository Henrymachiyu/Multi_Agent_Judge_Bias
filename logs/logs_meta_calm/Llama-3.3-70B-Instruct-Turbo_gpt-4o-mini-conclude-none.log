def is_prime(n):
    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def last_three_primes(numbers):
    primes = []
    for num in reversed(numbers):
        if is_prime(num):
            primes.append(num)
        if len(primes) == 3:
