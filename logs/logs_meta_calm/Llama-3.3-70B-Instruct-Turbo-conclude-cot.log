def find_pairs(numbers, target):
    # Create a dictionary to store the pairs and their counts
    pairs = {}

    # Iterate through the list of numbers
    for num in numbers:
        # If the current number is already in the dictionary, increment its count
        if num in pairs:
            pairs[num] += 1
        # Otherwise, add the number to the dictionary with a count of 1
        else:
            pairs[num] = 1

    # Iterate through the dictionary to find all unique pairs that add up to the target sum
    result = []
    for num in pairs:
        # If the current number's count is less than the target sum, add it to the result list
        if pairs[num] < target:
            result.append([num, target - pairs[num]])

    return result


