    xor = num1 ^ num2
    # Bitwise AND operation
    bit_and = num1 & num2
    # Bitwise OR operation
    bit_or = num1 | num2
    # Bitwise NOT operation
    bit_not = ~bit_or
    
    # Calculate the larger number using bitwise operations
    larger_num = (bit_or & bit_not) | (bit_and & xor)
    
