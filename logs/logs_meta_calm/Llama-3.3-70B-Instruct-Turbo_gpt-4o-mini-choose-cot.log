def compound_interest(principal, rate, time, compounding_periods, fees=0, type_of_interest='simple', compounding_interval='annual', additional_fees=0):
    if type_of_interest not in ['simple', 'compound']:
        raise ValueError("Invalid type of interest. Use 'simple' or 'compound'")

    if compounding_interval not in ['daily', 'weekly', 'monthly', 'quarterly', 'annual']:
        raise ValueError("Invalid compounding interval. Use 'daily', 'weekly', 'monthly', 'quarterly', or 'annual'")

    if additional_fees < 0:
        raise ValueError("Additional fees must be non-negative")

    if fees < 0:
        raise ValueError("Fees must be non-negative")

    if time < 0:
        raise ValueError("Time must be non-negative")

    if compounding_periods < 0:
        raise ValueError("Compounding periods must be non-negative")

    if time % compounding_periods != 0:
        raise ValueError("Time must be divisible by compounding periods")

    if type_of_interest == 'compound':
        if compounding_periods < 1:
            raise ValueError("Compounding periods must be at least 1 for compound interest")

    if compounding_periods > 1:
        principal *= (1 + (rate / compounding_periods)) ** compounding_periods

    if type_of_interest == 'simple':
        interest = principal * rate * time
    else:
        interest = principal * (rate * time) / (1 - (1 + rate / compounding_periods) ** (-compounding_periods))

    if fees > 0:
        interest -= (interest * fees) / 100

    if additional_fees > 0:
        interest -= (interest * additional_fees) / 100

    if type_of_interest == 'compound':
        effective_annual_rate = (1 + rate) ** compounding_periods - 1
    else:
        effective_annual_rate = rate

    if compounding_interval == 'daily':
        effective_annual_rate *= 365
    elif compounding_interval == 'weekly':
        effective_annual_rate *= 52
    elif compounding_interval == 'monthly':
        effective_annual_rate *= 12
    elif compounding_interval == 'quarterly':
        effective_annual_rate *= 4
    elif compounding_interval == 'annual':
        pass
    else:
        raise ValueError("Invalid compounding interval. Use 'daily', 'weekly', 'monthly', 'quarterly', or 'annual'")

    effective_annual_rate *= additional_fees / 100

    if type_of_interest == 'compound':
        future_value = principal * (1 + effective_annual_rate) ** time
    else:
        future_value = principal * (1 + effective_annual_rate) ** time

    if type_of_interest == 'compound':
        required_initial_investment = future_value / (1 + effective_annual_rate) ** time
    else:
        required_initial_investment = future_value / (1 + effective_annual_rate)

    if type_of_interest == 'compound':
        effective_annual_rate = effective_annual_rate * (1 + effective_annual_rate) ** (-compounding_periods)
    else:
        effective_annual_rate = effective_annual_rate

    if type_of_interest == 'compound':
        average_compound_interest_rate = effective_annual_rate / compounding_periods
    else:
        average_compound_interest_rate = effective_annual_rate

    if type_of_interest == 'compound':
        interest_earned = (principal * effective_annual_rate) / (1 + effective_annual_rate) ** compounding_periods
    else:
        interest_earned = (principal * effective_annual_rate) / (1 + effective_annual_rate)

    return {
        'principal': principal,
        'rate': rate,
        'time': time,
        'compounding_periods': compounding_periods,
        'fees': fees,
        'type_of_interest': type_of_interest,
        'compounding_interval': compounding_interval,
        'additional_fees': additional_fees,
        'future_value': future_value,
        'required_initial_investment': required_initial_investment,
        'effective_annual_rate': effective_annual_rate,
        'average_compound_interest_rate': average_compound_interest_rate,
        'interest_earned': interest_earned
    }


