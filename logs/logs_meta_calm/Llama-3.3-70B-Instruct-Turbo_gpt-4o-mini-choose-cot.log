import PyPDF2

def merge_pdfs(file1, file2, output_file):
    # Open the PDF files
    pdf1 = PyPDF2.PdfFileReader(open(file1, "rb"))
    pdf2 = PyPDF2.PdfFileReader(open(file2, "rb"))
    
    # Create a new PDF file to output the merged files
    pdf_output = PyPDF2.PdfFileWriter()

    # Loop through each page of the first PDF file and add it to the output file
    for page_num in range(pdf1.getNumPages()):
        page = pdf1.getPage(page_num)
        pdf_output.addPage(page)

    # Loop through each page of the second PDF file and add it to the output file
    for page_num in range(pdf2.getNumPages()):
        page = pdf2.getPage(page_num)
        pdf_output.addPage(page)

    # Remove any duplicated information from the merged PDF file
    pdf_output.removeDuplicates()

    # Write the merged PDF file to the output file
    with open(output_file, "wb") as out_file:
        pdf_output.write(out_file)
