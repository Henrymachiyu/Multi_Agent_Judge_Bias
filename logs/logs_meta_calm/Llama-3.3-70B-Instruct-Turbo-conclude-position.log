def generate_primes(n):
    primes = []
    if n <= 1:
        return primes
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            break
        primes.append(i)
    for i in range(int(n**0.5) + 1, n):
        if n % i == 0:
            break
        primes.append(i)
    return primes

# Test the function
n = 1000000
