def is_prime(n):
    if n <= 1:
        return False
    for i in range(2, int(n ** 0.5) + 1):
        if n % i == 0:
            return False
    return True

def sum_prime_factors(n):
    factors = []
    i = 2
    while i <= n:
        if is_prime(i) and n % i == 0:
            factors.append(i)
            n //= i
        else:
            i += 1
