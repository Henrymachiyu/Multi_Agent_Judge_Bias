def longest_common_subsequence(x, y):
    m = len(x)
    n = len(y)

    # Create a table to store lengths of the longest common subsequence
    dp = [[0] * (n + 1) for _ in range(m + 1)]

    # Build the dp table in bottom-up manner
    for i in range(1, m + 1):
        for j in range(1, n + 1):
            if x[i - 1] == y[j - 1]:
                dp[i][j] = dp[i - 1][j - 1] + 1
            else:
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])

    # Backtrack to find all possible LCSs
    lcs = []
    i, j = m, n
    while i > 0 and j > 0:
        if x[i - 1] == y[j - 1]:
            lcs.append(x[i - 1])
            i -= 1
            j -= 1
        elif dp[i - 1][j] > dp[i][j - 1]:
            i -= 1
        else:
            j -= 1

    # Print the length of the longest common subsequence and all possible LCSs
    print(f"Length of longest common subsequence: {len(lcs[0])}")
    print("Possible longest common subsequences:")
