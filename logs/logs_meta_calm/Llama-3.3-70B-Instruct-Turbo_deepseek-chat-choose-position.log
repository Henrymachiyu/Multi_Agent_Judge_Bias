def calculate_scores(questions, options, weights):
    scores = [0] * 4
    for i in range(len(questions)):
        score = 0
        for j in range(len(options[i])):
            if options[i][j] == 'A':
                score += weights[i] * scores[0]
            elif options[i][j] == 'B':
                score += weights[i] * scores[1]
            elif options[i][j] == 'C':
