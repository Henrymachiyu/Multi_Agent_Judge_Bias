    elif unit == "oz":
        kg = value / 35.2739619
        lbs = value / 16
        g = kg * 1000
        mg = kg * 10**6
        ug = kg * 10**9
        return f"{value}oz = {kg:.2f}kg = {lbs:.2f}lbs = {g:.2f}g = {mg:.2f}mg = {ug:.2f}μg"
    elif unit == "g":
        kg = value / 1000
        lbs = kg / 0.45359237
        oz = kg * 35.2739619
        mg = value * 10**3
        ug = value * 10**6
        return f"{value}g = {kg:.2f}kg = {lbs:.2f}lbs = {oz:.2f}oz = {mg:.2f}mg = {ug:.2f}μg"
    elif unit == "mg":
        kg = value / 10**6
        lbs = kg / 0.45359237
        oz = kg * 35.2739619
        g = value / 10**3
        ug = value * 10**3
        return f"{value}mg = {kg:.2f}kg = {lbs:.2f}lbs = {oz:.2f}oz = {g:.2f}g = {ug:.2f}μg"
    elif unit == "μg":
        kg = value / 10**9
        lbs = kg / 0.45359237
        oz = kg * 35.2739619
        g = value / 10**6
        mg = value / 10**3
        return f"{value}μg = {kg:.2f}kg = {lbs:.2f}lbs = {oz:.2f}oz = {g:.2f}g = {mg:.2f}mg"
    else:
        return "Error: Invalid unit"
```
