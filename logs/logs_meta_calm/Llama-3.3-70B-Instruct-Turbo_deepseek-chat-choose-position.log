        raise ValueError("Input must be a list")

    even_count = 0
    odd_count = 0
    negative_count = 0
    positive_count = 0

    for num in arr:
        if num % 2 == 0:
            even_count += 1
        elif num % 2 == 1:
            odd_count += 1
        elif num < 0:
            negative_count += 1
        else:
            positive_count += 1

    most_even = max(arr, key=lambda x: arr.count(x))
    least_even = min(arr, key=lambda x: arr.count(x))
