    if type_of_interest not in ['simple', 'compound']:
        raise ValueError("Invalid type of interest. Use 'simple' or 'compound'. The type of interest must be specified correctly.")

    if compounding_interval not in ['daily', 'weekly', 'monthly', 'quarterly', 'annual']:
