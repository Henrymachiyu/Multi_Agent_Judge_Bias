            elif options[i][j] == 'C':  # If the option is 'C'
                score += weights[i] * scores[2]  # Multiply the weight by the score for option 'C'
            elif options[i][j] == 'D':  # If the option is 'D'
                score += weights[i] * scores[3]  # Multiply the weight by the score for option 'D'
        scores = [score] + scores  # Update the scores list
    return scores  # Return the final scores list

