def convert_unit(unit, value):
    if unit == "kg":
        return {
            "lbs": value * 2.20462,  # Converts kilograms to pounds
            "oz": value * 35.274,    # Converts kilograms to ounces
            "g": value * 1000,       # Converts kilograms to grams
            "mg": value * 1000000,   # Converts kilograms to milligrams
            "μg": value * 1000000000 # Converts kilograms to micrograms
        }
    elif unit == "lbs":
        return {
            "kg": value / 2.20462,   # Converts pounds to kilograms
            "oz": value * 16,        # Converts pounds to ounces
            "g": value * 453.592,    # Converts pounds to grams
            "mg": value * 453592,    # Converts pounds to milligrams
            "μg": value * 453592000  # Converts pounds to micrograms
        }
    elif unit == "oz":
        return {
            "kg": value / 35.274,    # Converts ounces to kilograms
            "lbs": value / 16,       # Converts ounces to pounds
            "g": value * 28.3495,    # Converts ounces to grams
            "mg": value * 28349.5,   # Converts ounces to milligrams
            "μg": value * 28349500   # Converts ounces to micrograms
        }
    elif unit == "g":
        return {
            "kg": value / 1000,      # Converts grams to kilograms
            "lbs": value / 453.592,  # Converts grams to pounds
            "oz": value / 28.3495,   # Converts grams to ounces
            "mg": value * 1000,      # Converts grams to milligrams
            "μg": value * 1000000    # Converts grams to micrograms
        }
    elif unit == "mg":
        return {
            "kg": value / 1000000,   # Converts milligrams to kilograms
            "lbs": value / 453592,   # Converts milligrams to pounds
            "oz": value / 28349.5,   # Converts milligrams to ounces
            "g": value / 1000,       # Converts milligrams to grams
            "μg": value * 1000       # Converts milligrams to micrograms
        }
    elif unit == "μg":
        return {
            "kg": value / 1000000000,# Converts micrograms to kilograms
            "lbs": value / 453592000,# Converts micrograms to pounds
            "oz": value / 28349500,  # Converts micrograms to ounces
            "g": value / 1000000,    # Converts micrograms to grams
            "mg": value / 1000       # Converts micrograms to milligrams
        }
    else:
        raise ValueError("Invalid unit") # Raises an error for invalid units
```

You can use this function by calling it with the unit and value as arguments. This makes it incredibly easy to convert between different weight units. For example, to convert 2 kg to all the above units, you can call the function like this:

```python
