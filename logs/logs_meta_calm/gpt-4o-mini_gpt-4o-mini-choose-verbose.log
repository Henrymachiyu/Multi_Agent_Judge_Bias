class PrimeNumberIterator:
    def __init__(self):
        self.current = 1

    def __iter__(self):
        return self

    def __next__(self):
        self.current += 1
        while True:
            if self.current > 10:
                raise StopIteration
            elif self.is_prime(self.current):
                prime_number = self.current
                self.current += 1
                return prime_number
            self.current += 1

    def is_prime(self, num):
        if num < 2:
            return False
        for i in range(2, int(num ** 0.5) + 1):
            if num % i == 0:
                return False
        return True

# Usage:
