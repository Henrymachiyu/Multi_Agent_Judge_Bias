    if n <= 1:  # If the input number is less than or equal to 1, return an empty list.
        return primes
    for i in range(2, int(n**0.5) + 1):  # Loop through numbers starting from 2 up to the square root of n.
        if n % i == 0:  # Check if n is divisible by the current number i.
            break  # If divisible, break out of the loop.
        primes.append(i)  # Append the number i to the list of primes if it's not divisible.
    for i in range(int(n**0.5) + 1, n):  # Continue the loop from the square root of n to n.
