```python
class Graph:
    def __init__(self, vertices):
        self.V = vertices
        self.adj = [[] for _ in range(vertices)]

    def add_edge(self, u, v):
        self.adj[u].append(v)

    def bfs(self, s, d):
        visited = [False] * self.V
        queue = []
        visited[s] = True
        queue.append(s)

        while queue:
            s = queue.pop(0)
            if s == d:
                return True
            for i in self.adj[s]:
                if not visited[i]:
                    visited[i] = True
                    queue.append(i)

        return False

# Example usage:
