        # If there were zero calls on this day, include it in the current group
        if calls == 0:

            # If this is the first zero call day in the group, set the start date
            if current_group_start_date is None:
                current_group_start_date = date

            # Update the end date and length of the group
            current_group_end_date = date
            current_group_length += 1

        # If there were calls on this day, end the current group and add it to the list of groups
        else:

            # If there was a current group, add it to the list of groups
            if current_group_start_date is not None:
                groups.append({'start_date': current_group_start_date,
                               'end_date': current_group_end_date,
                               'num_days': current_group_length})

            # Reset the current group variables
            current_group_start_date = None
            current_group_end_date = None
            current_group_length = 0

            # If there are missing dates between the last non-zero call day and this call day, add them to the last group
            if i > 0:
                prev_date, _ = sorted_data[i-1]
                missing_dates = get_missing_dates(prev_date, date)
                if missing_dates:
                    last_group = groups[-1]
                    last_group['end_date'] = date
                    last_group['num_days'] += len(missing_dates)

    # If there was a current group at the end, add it to the list of groups
    if current_group_start_date is not None:
        groups.append({'start_date': current_group_start_date,
                       'end_date': current_group_end_date,
                       'num_days': current_group_length})

    # Sort the groups by start date and return the list
    return sorted(groups, key=lambda x: x['start_date'])


def get_missing_dates(start_date, end_date):
    """
    This function returns a list of all missing dates (if any) between two given dates.

    :param start_date: the start date (inclusive)
    :param end_date: the end date (exclusive)
    :return: a list of missing dates (as datetime objects)
    """

    # Convert the start and end dates to datetime objects
    start_date = datetime.strptime(start_date, '%Y-%m-%d')
    end_date = datetime.strptime(end_date, '%Y-%m-%d')

    # Initialize variables
    missing_dates = []

    # Use binary search to identify missing dates
    while start_date < end_date:
        mid_date = start_date + (end_date - start_date) // 2
        mid_date_str = mid_date.strftime('%Y-%m-%d')

        if mid_date_str in data:
            start_date = mid_date + timedelta(days=1)
        else:
            end_date = mid_date
            missing_dates.append(mid_date)

    return missing_dates
