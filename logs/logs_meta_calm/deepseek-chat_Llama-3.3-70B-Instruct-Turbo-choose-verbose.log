import sqlite3

def swap_values(var1, var2):
    # Check if both variables are dictionaries
    if isinstance(var1, dict) and isinstance(var2, dict):
        var1, var2 = var2, var1  # Swap the dictionaries
        return (var1, var2), (type(var1), type(var2))  # Return swapped values and types
    # Check if both variables are lists
    elif isinstance(var1, list) and isinstance(var2, list):
        var1, var2 = var2, var1  # Swap the lists
        return (var1, var2), (type(var1), type(var2))  # Return swapped values and types
    # Check if both variables are tuples
    elif isinstance(var1, tuple) and isinstance(var2, tuple):
        var1, var2 = var2, var1  # Swap the tuples
        return (var1, var2), (type(var1), type(var2))  # Return swapped values and types
    # Check if both variables are SQLite connections
    elif isinstance(var1, sqlite3.Connection) and isinstance(var2, sqlite3.Connection):
        cursor1 = var1.cursor()  # Create a cursor for the first connection
        cursor2 = var2.cursor()  # Create a cursor for the second connection
        cursor1.execute("SELECT * FROM table1")  # Execute a query on the first cursor
        cursor2.execute("SELECT * FROM table2")  # Execute a query on the second cursor
        var1, var2 = cursor2.fetchall(), cursor1.fetchall()  # Swap the fetched data
        return (var1, var2), (type(var1), type(var2))  # Return swapped values and types
    # Check if the first variable is complex and the second is a string
    elif isinstance(var1, complex) and isinstance(var2, str):
        var1, var2 = var2, var1  # Swap complex number and string
        return (var1, var2), (type(var1), type(var2))  # Return swapped values and types
    else:
        raise ValueError("Invalid input variables")  # Raise an error for invalid inputs

