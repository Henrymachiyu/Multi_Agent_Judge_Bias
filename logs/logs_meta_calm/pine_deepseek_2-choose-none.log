        self.num = 1

    def __iter__(self):
        return self

    def __next__(self):
        while True:
            if self.is_prime(self.num):
                self.num += 1
                return self.num
            else:
                self.num += 1

    def is_prime(self, n):
        if n < 2:
            return False
        for i in range(2, int(n**0.5) + 1):
            if n % i == 0:
                return False
        return True

# Test the iterator
