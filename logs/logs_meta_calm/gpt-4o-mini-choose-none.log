```python
# Define the scoring system
scores = {'A': [4, 3, 2, 1], 'B': [3, 4, 1, 2], 'C': [2, 1, 4, 3], 'D': [1, 2, 3, 4]}

# Define the weight of each question
weights = {'Q1': 5, 'Q2': 6, 'Q3': 3, 'Q4': 2, 'Q5': 7, 'Q6': 4, 'Q7': 1, 'Q8': 8, 'Q9': 9, 'Q10': 10}

# Define the answers to each question as a dictionary of lists
answers = {'Q1': ['A', 'B', 'C', 'D'], 'Q2': ['B', 'C', 'A', 'D'], 'Q3': ['C', 'D', 'B', 'A'],
           'Q4': ['D', 'A', 'B', 'C'], 'Q5': ['A', 'B', 'C', 'D'], 'Q6': ['B', 'C', 'A', 'D'],
           'Q7': ['C', 'D', 'B', 'A'], 'Q8': ['D', 'A', 'B', 'C'], 'Q9': ['A', 'B', 'C', 'D'],
           'Q10': ['B', 'C', 'A', 'D']}

# Define a dictionary to store the scores for each option (A, B, C, D)
option_scores = {'A': 0, 'B': 0, 'C': 0, 'D': 0}

# Loop over each question and answer to calculate the option scores
for question in answers:
    weight = weights[question]
    for i, option in enumerate(answers[question]):
        option_scores[option] += weight * scores[option][i]

# Sort the option scores in decreasing order
sorted_scores = sorted(option_scores.items(), key=lambda x: x[1], reverse=True)

# Print the final scores
