                score += weights[i] * scores[0]
            elif options[i][j] == 'B':
                score += weights[i] * scores[1]
            elif options[i][j] == 'C':
                score += weights[i] * scores[2]
            elif options[i][j] == 'D':
                score += weights[i] * scores[3]
        scores = [score] + scores
    return scores

