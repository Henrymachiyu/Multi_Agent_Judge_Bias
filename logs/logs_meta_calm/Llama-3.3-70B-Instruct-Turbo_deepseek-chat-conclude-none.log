def prime_factors(n):
    factors = []
    i = 2
    while i * i <= n:
        if n % i:
            factors.append(i)
        i += 1
    return factors

def sum_of_prime_factors(n):
    factors = prime_factors(n)
    return sum(factors)

def main():
    dictionary = {}
    keys = [2, 3, 4, 5]
    for key in keys:
        value = sum_of_prime_factors(key)
        dictionary[key] = value

    sorted_list = sorted(dictionary.items(), key=lambda x: x[1], reverse=True)

    print(dictionary)
    print(sorted_list)

