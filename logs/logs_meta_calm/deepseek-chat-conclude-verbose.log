def common_word(text):
    # Remove punctuation and convert to lowercase
    text = ''.join(c.lower() for c in text if c not in ('!', '.', ':', ',', '?', ';', '-', '_', '(', ')', '[', ']', '{', '}', ' ', '\t', '\n', '\r'))
    
    # Split the text into words
    words = text.split()
    
    # Create a set of all words in the text
    word_set = set(words)
    
    # Find the most common word in the set
    common_word = max(word_set, key=word_set.count)
    
