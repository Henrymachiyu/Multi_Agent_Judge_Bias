def common_word(text):
    # Remove punctuation and convert to lowercase
    # The process begins by removing punctuation marks such as '!', '.', ':', ',', '?', ';', '-', '_', '(', ')', '[', ']', '{', '}', and various spaces and line breaks.
    # This is achieved by iterating over each character in the text string.
