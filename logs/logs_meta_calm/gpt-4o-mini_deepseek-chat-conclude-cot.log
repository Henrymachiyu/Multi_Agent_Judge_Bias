def delete_duplicates(lst):
    unique_elements = []
    counts = {}

    for element in lst:
        if element not in counts:
            counts[element] = 1
        else:
            counts[element] += 1

    for element, count in counts.items():
        unique_elements.append((element, count))

    return unique_elements
```

