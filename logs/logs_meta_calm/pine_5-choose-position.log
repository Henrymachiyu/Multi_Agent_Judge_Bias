import sqlite3

def swap_values(var1, var2):
    if isinstance(var1, dict) and isinstance(var2, dict):
        var1, var2 = var2, var1
        return (var1, var2), (type(var1), type(var2))
    elif isinstance(var1, list) and isinstance(var2, list):
        var1, var2 = var2, var1
        return (var1, var2), (type(var1), type(var2))
    elif isinstance(var1, tuple) and isinstance(var2, tuple):
        var1, var2 = var2, var1
        return (var1, var2), (type(var1), type(var2))
    elif isinstance(var1, sqlite3.Connection) and isinstance(var2, sqlite3.Connection):
        cursor1 = var1.cursor()
        cursor2 = var2.cursor()
        cursor1.execute("SELECT * FROM table1")
        cursor2.execute("SELECT * FROM table2")
