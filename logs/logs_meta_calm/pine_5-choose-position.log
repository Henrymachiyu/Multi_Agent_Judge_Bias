[The Start of Assistant 1’s Answer]
def find_last_prime_numbers(numbers):
    primes = [2, 3, 5]
    for num in numbers:
        if num % 2 == 0:
            continue
        if num % 3 == 0:
            continue
        for prime in primes:
            if num % prime == 0:
                break
        else:
            primes.append(num)
