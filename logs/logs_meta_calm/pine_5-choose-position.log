def reverse_words(sentence):
    words = sentence.split()
    reversed_words = []
    for word in words:
        if len(word) % 2 != 0:
            reversed_word = word[::-1]
            reversed_words.append(reversed_word)
        else:
            reversed_words.append(word)
    return ' '.join(reversed_words)

