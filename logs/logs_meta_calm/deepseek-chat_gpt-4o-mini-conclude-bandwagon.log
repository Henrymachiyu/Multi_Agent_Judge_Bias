```python
def delete_duplicates(lst):
    count_dict = {}
    result = []
    for num in lst:
        if num in count_dict:
            count_dict[num] += 1
        else:
            count_dict[num] = 1
    
    for num in lst:
        if count_dict[num] > 0:
            result.append((num, count_dict[num]))
            count_dict[num] = 0
    
    return result
```

