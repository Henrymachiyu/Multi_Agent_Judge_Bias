import sqlite3

def delete_row(conn, table_name, condition):
    with conn:
        conn.execute("BEGIN")
        try:
            rows_deleted = conn.execute(f"DELETE FROM {table_name} WHERE {condition}")
            conn.commit()
            print(f"{rows_deleted} rows deleted")
        except sqlite3.Error as e:
            print(e)
            conn.rollback()
        finally:
            conn.close()

# Example usage:
