```python
def parse_json(json_str):
    json_dict = {}
    current_key = None
    current_value = None
    is_key = True
    is_string = False

    i = 0
    while i < len(json_str):
        c = json_str[i]

        if c == '"':
            if is_string:
                if is_key:
                    current_key = current_value
                else:
                    json_dict[current_key] = current_value
                current_key = None
                current_value = None
                is_key = not is_key
            is_string = not is_string
        elif c.isdigit() and is_string:
            if current_value is None:
                current_value = int(c)
            else:
                current_value = current_value * 10 + int(c)
        elif c == ',':
            if not is_string:
                json_dict[current_key] = current_value
                current_key = None
                current_value = None
                is_key = True
        elif c == '}':
            if not is_string:
                json_dict[current_key] = current_value
            break

        i += 1

    return json_dict

# Example usage
