```python
def is_prime(n):
    """Check if a number is prime."""
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def sum_of_prime_factors(n):
    """Calculate the sum of prime factors of a number."""
    factors = set()
    i = 2
    while i * i <= n:
        if n % i:
            i += 1
        else:
            n //= i
            factors.add(i)
    if n > 1:
        factors.add(n)
    return sum(factors)

def create_dictionary_and_sorted_list(input_dict):
    """Create a dictionary with sums of prime factors and a sorted list of tuples."""
    result_dict = {}
    for key in input_dict:
        result_dict[key] = sum_of_prime_factors(key)
    
    sorted_list = sorted(result_dict.items(), key=lambda x: x[1])
    return result_dict, sorted_list

input_dict = {2: 2, 3: 3, 4: 4, 5: 5}
result_dict, sorted_list = create_dictionary_and_sorted_list(input_dict)

print("Result Dictionary:", result_dict)
print("Sorted List of Tuples:", sorted_list)
```

