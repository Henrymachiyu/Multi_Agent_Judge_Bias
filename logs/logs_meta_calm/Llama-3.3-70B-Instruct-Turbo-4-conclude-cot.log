            i -= 1
            j -= 1
        elif dp[i - 1][j] > dp[i][j - 1]:
            i -= 1
        else:
            j -= 1

    # Print the length of the longest common subsequence and all possible LCSs
    print(f"Length of longest common subsequence: {len(lcs[0])}")
    print("Possible longest common subsequences:")
