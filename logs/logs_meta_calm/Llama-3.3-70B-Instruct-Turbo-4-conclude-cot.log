def count_freq(arr):
    if not isinstance(arr, list):
        raise ValueError("Input must be a list")

    even_count = 0
    odd_count = 0
    negative_count = 0
    positive_count = 0

    for num in arr:
        if num % 2 == 0:
            even_count += 1
        elif num % 2 == 1:
            odd_count += 1
        elif num < 0:
            negative_count += 1
        else:
            positive_count += 1

    most_even = max(arr, key=lambda x: arr.count(x))
    least_even = min(arr, key=lambda x: arr.count(x))
    most_odd = max(arr, key=lambda x: arr.count(x))
    least_odd = min(arr, key=lambda x: arr.count(x))

    print(f"Even numbers: {even_count}")
    print(f"Odd numbers: {odd_count}")
    print(f"Negative numbers: {negative_count}")
    print(f"Positive numbers: {positive_count}")

    print(f"Most frequent even number: {most_even}")
    print(f"Least frequent even number: {least_even}")
    print(f"Most frequent odd number: {most_odd}")
    print(f"Least frequent odd number: {least_odd}")

    return most_even, least_even, most_odd, least_odd
