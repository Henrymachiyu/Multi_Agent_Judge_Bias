```python
def reverse_and_sort_descending(nums):
    # Step 1: Reverse the array
    reversed_nums = nums[::-1]
    
    # Step 2: Sort in descending order
    sorted_nums = sorted(reversed_nums, reverse=True)
    
    return sorted_nums

