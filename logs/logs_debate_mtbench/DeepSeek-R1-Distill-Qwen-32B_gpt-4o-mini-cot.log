def calculate_product(numbers, upper_limit):
    product = 1
    for num in numbers:
        if num == 0:
            return "Error: Zero value detected. Product is zero."
        product *= num
        if product > upper_limit:
            return "Error: Product exceeds the upper limit."
    return product

# Example usage
