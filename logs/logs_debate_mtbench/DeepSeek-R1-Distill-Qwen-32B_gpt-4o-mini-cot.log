def reverse_list(lst):
    start = 0
    end = len(lst) - 1

    while start < end:
        if lst[start] < 0:
            start += 1
        elif lst[end] > 0:
            end -= 1
        else:
            lst[start], lst[end] = lst[end], lst[start]
            start += 1
            end -= 1

    # Now we need to reverse the non-negative part
    # Reverse the non-negative part of the list
