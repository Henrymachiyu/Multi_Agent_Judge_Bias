def filter_and_sort(lst, target):
    # Ensure the list has no duplicates
    lst = list(set(lst))
    
    # Check if the target is within the range of the list
    if min(lst) > target or max(lst) < target:
        raise ValueError("The target integer must be within the range of the list")

    # Create a new list with only elements greater than the target
    new_lst = [x for x in lst if x > target]

    # Sort the new list in ascending order
    new_lst.sort()

    return new_lst
```


