def reverse_odd_words(sentence):
    words = sentence.split()
    for i in range(len(words)):
        # Remove punctuation for length check (optional, depends on requirements)
        word_clean = ''.join([c for c in words[i] if c.isalpha()])
        if len(word_clean) % 2 != 0:
            words[i] = words[i][::-1]
    return ' '.join(words)
```
