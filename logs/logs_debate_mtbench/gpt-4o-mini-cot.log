### My Solution:
```python
def find_pairs(nums, target):
    pairs = []
    seen = set()  # To track numbers we've seen
    unique_pairs = set()  # To track unique pairs

    for num in nums:
        complement = target - num
        if complement in seen:
            # Create a sorted tuple to ensure uniqueness
            unique_pairs.add(tuple(sorted((num, complement))))
        seen.add(num)

    # Convert the set of unique pairs back to a list of lists
    return [list(pair) for pair in unique_pairs]

# Test the program
nums = [1, 2, 3, 4, 5]
target = 7
print(find_pairs(nums, target))  # Output: [[2, 5], [3, 4]]
