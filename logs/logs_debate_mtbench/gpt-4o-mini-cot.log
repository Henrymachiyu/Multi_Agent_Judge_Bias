def find_second_highest(nums):
    if len(nums) < 2:
        return None

    unique_nums = list(set(nums))  # Remove duplicates
    unique_nums.sort(reverse=True)  # Sort in descending order

    if len(unique_nums) < 2:
        return None  # Not enough unique numbers

    second_highest = unique_nums[1]  # Second highest number

    if nums.count(second_highest) > 1:  # Check if second highest is unique
        if len(unique_nums) < 3:
            return None  # Not enough unique numbers for a third highest
        return unique_nums[2]  # Return third highest

    return second_highest  # Return second highest if unique
```

