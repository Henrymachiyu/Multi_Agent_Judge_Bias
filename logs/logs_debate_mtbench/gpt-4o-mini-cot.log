# Iterate through the list and print the square root of prime numbers between 2 and 10
for num in my_list:
    if num >= 10:
        break
    if num < 2 or num > 10:
        print(f"Invalid number: {num}")
    elif is_prime(num):
        print(square_root(num))
    else:
        print(f"Invalid number: {num}")
```

