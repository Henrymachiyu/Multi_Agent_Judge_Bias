def reverse_array(nums):
    reversed_nums = []
    for i in range(len(nums) - 1, -1, -1):  # Iterate from the end to the start
        reversed_nums.append(nums[i])
    reversed_nums.sort(reverse=True)  # Sort in descending order
    return reversed_nums

