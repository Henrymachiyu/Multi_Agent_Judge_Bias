    if number == 0:
        return "0"
    
    is_negative = False
    if number < 0:
        is_negative = True
        number = abs(number)
    
    octal_digits = []
    while number > 0:
        remainder = number % 8
        octal_digits.append(str(remainder))
        number = number // 8
    
    octal_number = ''.join(reversed(octal_digits))
    if is_negative:
        octal_number = "-" + octal_number
    
    return octal_number

