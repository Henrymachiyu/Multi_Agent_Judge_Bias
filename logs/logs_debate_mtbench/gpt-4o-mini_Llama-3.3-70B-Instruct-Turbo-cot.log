def generate_sequence(start, increment, max_value=10):
    """
    Generates a sequence of numbers starting from 'start', incrementing by 'increment',
    up to 'max_value'.
    
    Args:
        start (int): The starting number of the sequence.
        increment (int): The increment value between numbers in the sequence.
        max_value (int, optional): The maximum value in the sequence. Defaults to 10.
    
    Returns:
        list: A list of numbers in the sequence.
    """
    sequence = []
    current = start
    while current <= max_value:
        sequence.append(current)
        current += increment
    return sequence

def main():
    try:
        # Prompt user for starting number and increment value
        start_num = int(input("Enter starting number: "))
        increment_val = int(input("Enter increment value: "))
        
        # Generate and print the sequence
        sequence = generate_sequence(start_num, increment_val)
        print("The sequence is:", sequence)
    
    except ValueError:
        print("Error: Invalid input. Please enter integers only.")
    
    except Exception as e:
        print("Error:", e)

if __name__ == "__main__":
    main()
```

