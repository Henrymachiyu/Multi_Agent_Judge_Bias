import random
import sympy

def generate_prime_numbers(limit):
    """Generate prime numbers up to the given limit."""
    primes = list(sympy.primerange(2, limit))
    return primes

def generate_array(rows, columns):
    """Generate a 2D array with unique prime numbers."""
    limit = rows * columns * 10  # Ensure we have enough primes
    primes = generate_prime_numbers(limit)
    
    array = [[0 for _ in range(columns)] for _ in range(rows)]
    used_primes = set()
    
    for i in range(rows):
        for j in range(columns):
            prime = random.choice(primes)
            while prime in used_primes:
                prime = random.choice(primes)
            array[i][j] = prime
            used_primes.add(prime)
            
    return array

def validate_array(array):
    """Validate that all elements in the array are unique prime numbers."""
    primes = set()
    for row in array:
        for num in row:
            if not sympy.isprime(num):
                return False
            if num in primes:
                return False
            primes.add(num)
    return True

# Generate and validate the array
