import sqlite3

def delete_row(db_path, table_name, condition):
    """
    Deletes a row from the specified table based on the given condition.
    
    :param db_path: Path to the SQLite database file.
    :param table_name: Name of the table from which to delete the row.
    :param condition: Condition to specify which row to delete.
    """
    try:
        # Connect to the database
        with sqlite3.connect(db_path) as conn:
            # Start a transaction
            conn.execute("BEGIN TRANSACTION")
            try:
                # Execute the deletion query
                cursor = conn.cursor()
                cursor.execute(f"DELETE FROM {table_name} WHERE {condition}")
                # Commit the transaction
                conn.commit()
                print(f"Row deleted from {table_name} where {condition}")
            except sqlite3.Error as e:
                # Rollback the transaction if an error occurs
                conn.execute("ROLLBACK")
                print(f"Error deleting row: {e}")
    except sqlite3.Error as e:
        print(f"Database connection error: {e}")

# Example usage
