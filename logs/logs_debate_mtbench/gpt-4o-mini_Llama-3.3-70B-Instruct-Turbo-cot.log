    json_dict = {}
    key = ""
    value = ""
    parsing_key = True
    in_string = False

    for char in json_str:
        if char == '"':
            in_string = not in_string
            if not in_string:  # End of a string
                if parsing_key:
                    current_key = key
                    key = ""
                    parsing_key = False
                else:
