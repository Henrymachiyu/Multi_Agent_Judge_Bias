3. **Fill the Array with Unique Primes**: We can use a loop to fill the array. For each position, select a random prime from a list of primes that have not been used yet.

4. **Validate the Array**: Check each number in the array to ensure it is prime and unique. We can use a set to keep track of the primes we've seen.

Here's a sample implementation:

```python
import random
import sympy

def generate_prime_array(rows, cols):
    # Generate a list of prime numbers
    primes = list(sympy.primerange(2, rows*cols*10))
    
    array = []
    used_primes = set()
    
    for _ in range(rows):
        row = []
        for _ in range(cols):
            # Select a random prime that hasn't been used
            available_primes = [p for p in primes if p not in used_primes]
            if not available_primes:
                raise ValueError("Not enough unique primes")
            prime = random.choice(available_primes)
            row.append(prime)
            used_primes.add(prime)
        array.append(row)
    
    return array

def validate_array(array):
    seen = set()
    for row in array:
        for num in row:
            if not sympy.isprime(num):
                return False
            if num in seen:
                return False
            seen.add(num)
    return True

# Example usage
