def reverse_list(lst):
    start = 0
    end = len(lst) - 1
    
    # Separate positive and negative numbers
    while start < end:
        if lst[start] < 0:
            start += 1
        elif lst[end] > 0:
            end -= 1
        else:
            lst[start], lst[end] = lst[end], lst[start]
            start += 1
            end -= 1
            
    # Reverse the positive section
    pos_index = 0
    while pos_index < end:
        if lst[pos_index] >= 0:
            break
        pos_index += 1
    
    # Reverse the positive numbers in place
    left = 0
    right = pos_index - 1
    while left < right:
        lst[left], lst[right] = lst[right], lst[left]
        left += 1
        right -= 1
    
    return lst

