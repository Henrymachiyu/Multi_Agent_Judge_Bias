import random

adjectives = ["lazy", "big", "smart", "funny", "clumsy"]
insult_words = ["oaf", "buffoon", "idiot"]

def generate_insult():
    adj1, adj2 = random.sample(adjectives, 2)
    insult_word = random.choice(insult_words)
    return f"you {adj1}, {adj2} {insult_word}!"

print(generate_insult())
