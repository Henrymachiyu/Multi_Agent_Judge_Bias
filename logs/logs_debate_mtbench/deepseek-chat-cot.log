```python
def print_dict(dictionary, indent=0):
    for key, value in dictionary.items():
        if isinstance(value, dict):
            print('\t' * indent + f"Key: {key}, Value:")
            print_dict(value, indent + 1)
        elif isinstance(value, str):
            print('\t' * indent + f"Key: {key}, Value: {value}")

# Example usage
my_dict = {
    'name': 'John',
    'address': {
        'street': '123 Main St',
        'city': 'New York'
    },
    'email': 'john@example.com'
}

print_dict(my_dict)
```
**Output**:
```
Key: name, Value: John
Key: address, Value:
    Key: street, Value: 123 Main St
    Key: city, Value: New York
Key: email, Value: john@example.com
```

