```python
import regex  # Handles grapheme clusters (e.g., emojis with modifiers)
def reverse_string_with_emojis(s):
    # Split into grapheme clusters (full emojis and characters)
    graphemes = regex.findall(r'\X', s)
    # Reverse only the non-emoji/non-special character clusters
    reversed_graphemes = []
    for g in reversed(graphemes):
        if not regex.match(r'[^\w\s]', g):
            reversed_graphemes.append(g)
        else:
            reversed_graphemes.insert(0, g)  # Preserve emoji/special character order
    return ''.join(reversed_graphemes)
```
