import json

def make_caipirinha(sweetness_level_json):
    # Load the sweetness level from the JSON data
    sweetness_data = json.loads(sweetness_level_json)
    sweetness_level = sweetness_data["sweetness_level"]
    
    # Calculate the amount of sugar based on the sweetness level
    max_sugar = 2  # Maximum amount of sugar in oz
    sugar = (sweetness_level / 10) * max_sugar
    
    # Print the recipe with the adjusted amount of sugar
    print("To make a caipirinha with a sweetness level of", sweetness_level)
    print("You will need:")
    print("- 2 oz cachaça")
    print("- 1 lime, cut into wedges")
    print("- ", sugar, "oz sugar")
    print("- ice")
    print("Directions:")
    print("1. Place the lime wedges and sugar in a glass.")
    print("2. Muddle the lime and sugar together.")
    print("3. Fill the glass with ice.")
