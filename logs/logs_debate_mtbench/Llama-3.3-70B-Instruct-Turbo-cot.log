import sqlite3

def swap_values(var1, var2):
    # Get original data types
    type1 = type(var1)
    type2 = type(var2)
    
    # Attempt to convert string to complex number if necessary
    if isinstance(var1, str) and isinstance(var2, complex):
        try:
            var1 = complex(var1)
        except ValueError:
            pass
    elif isinstance(var2, str) and isinstance(var1, complex):
        try:
            var2 = complex(var2)
        except ValueError:
            pass
    
    # Swap values
    var1, var2 = var2, var1
    
    # Return swapped values and original data types
    return (var1, var2, type1, type2)

def swap_values_sql(db_file, table_name, var1_col, var2_col, id_col, id_val):
    # Connect to database
    conn = sqlite3.connect(db_file)
    c = conn.cursor()
    
    # Get original values
    c.execute(f"SELECT {var1_col}, {var2_col} FROM {table_name} WHERE {id_col}=?", (id_val,))
    orig_vals = c.fetchone()
    
    # Swap values
    var1_db = orig_vals[1]
    var2_db = orig_vals[0]
    
    # Update database
    c.execute(f"UPDATE {table_name} SET {var1_col}=?, {var2_col}=?" + f" WHERE {id_col}=?", (var1_db, var2_db, id_val))
    conn.commit()
    
    # Close database connection
    conn.close()
    
    # Return swapped values and original data types
    return swap_values(orig_vals[0], orig_vals[1])


