```python
def is_prime(n):
    """Check if a number is prime."""
    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def all_primes(numbers):
    """Check if all numbers in a list are prime."""
    for num in numbers:
        if not is_prime(num):
            return False
    return True

# Example usage:
numbers_list = [2, 3, 5, 7, 11, 13]
print(all_primes(numbers_list))  # Output: True

numbers_list = [4, 6, 8, 10, 12, 14]
print(all_primes(numbers_list))  # Output: False
```

