Here's how this looks in Python:

```python
def find_longest_strings(strings):
    if not strings:
        return "", ""
    
    longest = strings[0]
    second_longest = ""

    for string in strings[1:]:
        if len(string) > len(longest):
            second_longest = longest
            longest = string
        elif len(string) > len(second_longest) and string != longest:
            second_longest = string

    if not second_longest:
        second_longest = longest

    return longest, second_longest

# Example usage:
print(find_longest_strings(["cherry", "apple", "applepie", "strawberry", "raspberry"]))
print(find_longest_strings(["banana", "mango", "grape", "kiwi"]))
```

