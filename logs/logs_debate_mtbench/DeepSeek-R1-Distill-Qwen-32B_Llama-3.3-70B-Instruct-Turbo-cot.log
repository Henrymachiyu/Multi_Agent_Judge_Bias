```python
import os

def find_files_by_extension(directory, extension):
    """
    Finds all files with a specified extension in a directory and its subdirectories.
    
    Parameters:
    - directory: The path to the directory to search in.
    - extension: The file extension to look for.
    
    Returns:
    - A list of paths to files with the specified extension.
    """
    matching_files = []
    for root, dirs, files in os.walk(directory):
        for file in files:
            if file.lower().endswith(extension.lower()):
                matching_files.append(os.path.join(root, file))
    return matching_files

