```python
import random
import sympy

def generate_primes(n):
    """Generate a list of n unique prime numbers."""
    primes = []
    num = 2
    while len(primes) < n:
        if sympy.isprime(num):
            primes.append(num)
        num += 1
    return primes

def generate_array(rows, columns):
    """Generate a 2D array with unique prime numbers."""
    n = rows * columns
    primes = generate_primes(n)
    random.shuffle(primes)  # Shuffle the primes to randomize their order
    array = [primes[i:i+columns] for i in range(0, n, columns)]
    return array

def validate_array(array):
    """Validate that each element in the array is a unique prime number."""
    seen = set()
    for row in array:
        for num in row:
            if not sympy.isprime(num) or num in seen:
                return False
            seen.add(num)
    return True

# Generate and validate the array
array = generate_array(9, 5)
if validate_array(array):
    print("Array is valid:")
    for row in array:
        print(row)
else:
    print("Array is not valid.")
```

