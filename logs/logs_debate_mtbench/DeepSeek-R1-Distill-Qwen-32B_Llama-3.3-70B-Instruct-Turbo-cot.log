from collections import defaultdict

def count_frequencies(arr):
    # Check if input is a list
    if not isinstance(arr, list):
        raise TypeError("Input must be a list")
    
    # Initialize counters
    freq = defaultdict(int)
    even_count = 0
    odd_count = 0
    positive_count = 0
    negative_count = 0
    
    # Count frequencies
    for num in arr:
        # Check if element is an integer
        if not isinstance(num, int):
            raise TypeError("All elements in the list must be integers")
        
        freq[num] += 1
        if num % 2 == 0:
            even_count += 1
        else:
            odd_count += 1
        if num > 0:
            positive_count += 1
        elif num < 0:
            negative_count += 1
    
    # Print frequencies
    print(f"Even numbers: {even_count}")
    print(f"Odd numbers: {odd_count}")
    print(f"Positive numbers: {positive_count}")
    print(f"Negative numbers: {negative_count}")
    
    # Find the two most frequent even and odd numbers
    even_nums = [(num, freq) for num, freq in freq.items() if num % 2 == 0]
    odd_nums = [(num, freq) for num, freq in freq.items() if num % 2 != 0]
    
    even_nums.sort(key=lambda x: (-x[1], x[0]))
    odd_nums.sort(key=lambda x: (-x[1], x[0]))
    
    most_freq_even = [num for num, freq in even_nums[:2]]
    most_freq_odd = [num for num, freq in odd_nums[:2]]
    
    return most_freq_even, most_freq_odd

# Example usage
