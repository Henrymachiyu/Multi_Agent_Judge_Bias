import re

def reverse_string_with_emojis(s):
    # Find all emojis and special characters in the string
    emojis = re.findall(r'[^\w\s]', s)
    
    # Remove emojis and special characters, reverse the string
    s_without_emojis = re.sub(r'[^\w\s]', '', s)[::-1]
    
    # Initialize result string and emoji index
    result = ''
    emoji_index = 0
    
    # Initialize a list to store the positions of emojis in the original string
    emoji_positions = [m.start() for m in re.finditer(r'[^\w\s]', s)]
    
    # Iterate over the reversed string without emojis
    for i, char in enumerate(s_without_emojis):
        result += char
        # If the current position in the original string had an emoji, add it
        if emoji_index < len(emoji_positions) and i == len(s_without_emojis) - 1 - emoji_positions[emoji_index]:
            result += emojis[emoji_index]
            emoji_index += 1
    
    return result

# Example usage:
