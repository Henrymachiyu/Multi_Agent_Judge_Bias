    if isinstance(var1, str) and isinstance(var2, complex):
        try:
            var1 = complex(var1)
        except ValueError:
            pass
    elif isinstance(var2, str) and isinstance(var1, complex):
        try:
            var2 = complex(var2)
        except ValueError:
            pass
    
    # Swap values
    var1, var2 = var2, var1
    
    # Handle SQL database
    if db_file and table_name and var1_col and var2_col and id_col and id_val:
        conn = sqlite3.connect(db_file)
        c = conn.cursor()
        c.execute(f"UPDATE {table_name} SET {var1_col}=?, {var2_col}=?" + f" WHERE {id_col}=?", (var1, var2, id_val))
        conn.commit()
        conn.close()
    
    # Return swapped values and original data types
    return (var1, var2), (type1, type2)


