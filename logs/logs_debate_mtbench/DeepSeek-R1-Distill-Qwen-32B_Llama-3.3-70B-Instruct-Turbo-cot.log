def delete_rows(connection, condition):
    try:
        # Start a transaction
        cursor = connection.cursor()
        cursor.execute("BEGIN TRANSACTION")
        
        # Execute the complex query to find rows to delete
        cursor.execute(f"SELECT id FROM posts WHERE {condition}")
        rows_to_delete = cursor.fetchall()
        
        if rows_to_delete:
            # Prepare the delete statement
            delete_statement = "DELETE FROM posts WHERE id=?"
            # Execute the delete operation for each row
            for row in rows_to_delete:
