```python
import sqlite3

def delete_row(db_path, query):
    """
    Deletes rows from an SQLite database based on a complex query.
    
    Parameters:
    - db_path: Path to the SQLite database file.
    - query: A string representing the SQL query to select rows for deletion.
    
    Returns:
    - The number of rows deleted.
    """
    try:
        with sqlite3.connect(db_path) as conn:
            # Start a transaction
            conn.execute("BEGIN TRANSACTION")
            try:
                # Execute the query to get the IDs of rows to delete
                cursor = conn.cursor()
                cursor.execute(query)
                rows_to_delete = cursor.fetchall()
                
                # Assuming the query returns a list of IDs
                if rows_to_delete:
                    # Prepare the delete statement
                    delete_stmt = "DELETE FROM table_name WHERE id IN (%s)" % ",".join("?" for _ in rows_to_delete)
                    # Execute the delete statement
                    conn.execute(delete_stmt, [row[0] for row in rows_to_delete])
                # Commit the transaction
                conn.execute("COMMIT")
                return len(rows_to_delete) if rows_to_delete else 0
            except sqlite3.Error as e:
                # Rollback the transaction on error
                conn.execute("ROLLBACK")
                print(f"Error: {e}")
                return None
    except Exception as e:
        print(f"An error occurred: {e}")
        return None

# Example usage
db_path = "example.db"
query = "SELECT id FROM table_name WHERE condition"
rows_deleted = delete_row(db_path, query)
print(f"Rows deleted: {rows_deleted}")
