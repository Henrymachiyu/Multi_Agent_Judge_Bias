```python
def delete_duplicates(lst):
    count_dict = {}
    result = []
    seen = set()
    
    for num in lst:
        if num in count_dict:
            count_dict[num] += 1
        else:
            count_dict[num] = 1
    
    for num in lst:
        if num not in seen:
            result.append((num, count_dict[num]))
            seen.add(num)
    
    return result
