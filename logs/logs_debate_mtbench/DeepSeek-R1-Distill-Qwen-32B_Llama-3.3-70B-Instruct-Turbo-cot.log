from urllib.parse import urlparse

def extract_domain(url):
    parsed_url = urlparse(url)
    domain_parts = parsed_url.netloc.split('.')[-2:]  # Get the last two parts
    domain = '.'.join(domain_parts)  # Join them with a dot
