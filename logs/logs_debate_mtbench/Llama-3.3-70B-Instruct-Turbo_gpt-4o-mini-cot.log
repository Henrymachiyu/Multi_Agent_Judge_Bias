def delete_duplicates(lst):
    count_dict = {}
    order_list = []
    for num in lst:
        if num not in count_dict:
            count_dict[num] = 1
            order_list.append(num)
        else:
            count_dict[num] += 1
    result = [(num, count_dict[num]) for num in order_list]
    return result
```

