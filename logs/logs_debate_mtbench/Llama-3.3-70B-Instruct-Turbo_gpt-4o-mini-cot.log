```python
def find_frequencies(arr):
    # Check if the input is a valid array
    if not isinstance(arr, list):
        raise TypeError("Input must be an array")
    
    # Initialize counters for frequencies
    even_freq = {}
    odd_freq = {}
    pos_count = 0
    neg_count = 0
    
    # Loop through the array and count frequencies
    for num in arr:
        # Check if the element is an integer
        if not isinstance(num, int):
            raise TypeError("Array must contain only integers")
        
        if num % 2 == 0:
            # Even number
            even_freq[num] = even_freq.get(num, 0) + 1
        else:
            # Odd number
            odd_freq[num] = odd_freq.get(num, 0) + 1
        
        if num >= 0:
            pos_count += 1
        else:
            neg_count += 1
    
    # Sort frequencies in descending order
    sorted_even = sorted(even_freq.items(), key=lambda x: (-x[1], x[0]))
    sorted_odd = sorted(odd_freq.items(), key=lambda x: (-x[1], x[0]))
    
    # Get the two most frequent even numbers and the two most frequent odd numbers
    most_freq_even = [num for num, freq in sorted_even[:2]]
    most_freq_odd = [num for num, freq in sorted_odd[:2]]
    
    # Print frequencies
    print(f"Even numbers: {sum(even_freq.values())}")
    print(f"Odd numbers: {sum(odd_freq.values())}")
    print(f"Positive numbers: {pos_count}")
    print(f"Negative numbers: {neg_count}")
    
    return most_freq_even, most_freq_odd

# Example usage
