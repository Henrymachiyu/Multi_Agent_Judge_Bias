def is_prime(n):
    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def all_primes(numbers):
    for num in numbers:
        if not is_prime(num):
            return False
    return True

# Example usage:
