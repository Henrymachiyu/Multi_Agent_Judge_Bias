```python
import re

def reverse_string_with_emojis(s):
    # Find all emojis and special characters
    emojis = re.findall(r'[^\w\s]', s)
    
    # Reverse the string without emojis and special characters
    s_without_emojis = re.sub(r'[^\w\s]', '', s)
    reversed_s_without_emojis = s_without_emojis[::-1]
    
    # Create a list to hold the final reversed string
    result = []
    emoji_index = 0
    
    for char in s:
        if re.match(r'[^\w\s]', char):
            result.append(emojis[emoji_index])
            emoji_index += 1
        else:
            result.append(reversed_s_without_emojis[0])
            reversed_s_without_emojis = reversed_s_without_emojis[1:]
    
    return ''.join(result)

# Example usage
s = 'Hello, 😊 world! 👋🏼'
print(reverse_string_with_emojis(s))  # Output: '👋🏼! dlrow 😊 ,olleH'
```

