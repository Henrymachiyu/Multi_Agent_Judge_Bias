def find_majority_element(arr):
    # First pass: Find the candidate for majority element
    candidate = None
    count = 0
    for num in arr:
        if count == 0:
            candidate = num
            count = 1
        elif num == candidate:
            count += 1
        else:
            count -= 1
    
    # Second pass: Verify if the candidate is the majority element
    count = 0
    for num in arr:
        if num == candidate:
            count += 1
    
    if count > len(arr) // 2:
        return candidate
    else:
        return None
```

