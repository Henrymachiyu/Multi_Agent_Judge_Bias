import os
import re
from collections import Counter

def get_text_files(directory):
    """Get all text files in the directory and subdirectories."""
    text_files = []
    for root, dirs, files in os.walk(directory):
        for file in files:
            if file.endswith(".txt"):
                text_files.append(os.path.join(root, file))
    return text_files

def extract_words(text_files):
    """Extract words from all text files."""
    all_words = []
    for file in text_files:
        with open(file, 'r', encoding='utf-8') as f:
            text = f.read().lower()  # Convert to lower case
            words = re.findall(r'\b\w+\b', text)  # Use regex to find words
            all_words.extend(words)
    return all_words

def count_and_rank_words(all_words):
    """Count words and rank them by frequency."""
    word_count = Counter(all_words)
    top_5_words = word_count.most_common(5)
    return top_5_words

def main():
    directory = './'  # Specify the directory path
    text_files = get_text_files(directory)
    all_words = extract_words(text_files)
    top_5_words = count_and_rank_words(all_words)
    for word, count in top_5_words:
        print(f"{word}: {count}")

if __name__ == "__main__":
    main()
```
