import os
from collections import Counter

def count_words_in_file(file_path):
    with open(file_path, 'r', encoding='utf-8') as file:
        words = file.read().lower().split()
        # Simple word cleaning, consider using a more sophisticated method
        words = [word.strip('.,!?"\'') for word in words]
        return Counter(words)

def get_top_5_words(directory):
    total_word_counts = Counter()
    for root, dirs, files in os.walk(directory):
        for file in files:
            if file.endswith('.txt'):
                file_path = os.path.join(root, file)
                total_word_counts += count_words_in_file(file_path)
    
    return total_word_counts.most_common(5)

if __name__ == '__main__':
    directory = './'
    top_5_words = get_top_5_words(directory)
    for word, count in top_5_words:
        print(f'{word}: {count}')
```

