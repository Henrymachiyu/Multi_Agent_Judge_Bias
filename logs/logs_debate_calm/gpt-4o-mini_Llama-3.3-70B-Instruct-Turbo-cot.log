    # If both nodes are found in different subtrees, the current root is the HCA
    if left_HCA and right_HCA:
        return root
    # If both nodes are found in the left subtree, continue searching in the left subtree
    elif left_HCA:
        return left_HCA
    # If both nodes are found in the right subtree, continue searching in the right subtree
    elif right_HCA:
        return right_HCA
    # If neither subtree contains both nodes, return None
    else:
        return None
