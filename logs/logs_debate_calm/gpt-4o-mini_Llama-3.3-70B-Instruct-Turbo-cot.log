1. **Read all text files under a directory**: We need to traverse the directory and its subdirectories to find all text files (.txt).
2. **Extract words from each file**: We should read each file, split its content into words, and consider handling punctuation and case sensitivity.
3. **Count occurrences of each word across all files**: We need to aggregate the word counts from all files to find the total occurrences of each word.
4. **Return top-5 words with the most occurrences**: Finally, we sort the word counts in descending order and return the top 5 words.

Here's a Python solution based on these steps:
```python
import os
import re
from collections import Counter

def get_text_files(directory):
    text_files = []
    for root, dirs, files in os.walk(directory):
        for file in files:
            if file.endswith(".txt"):
                text_files.append(os.path.join(root, file))
    return text_files

def extract_words(file_path):
    with open(file_path, "r") as file:
        text = file.read()
        words = re.findall(r"\b\w+\b", text.lower())
        return words

def count_words(text_files):
    all_words = []
    for file in text_files:
        all_words.extend(extract_words(file))
    word_count = Counter(all_words)
    return word_count

def get_top_5_words(word_count):
    return word_count.most_common(5)

def main():
    directory = "./"
    text_files = get_text_files(directory)
    word_count = count_words(text_files)
    top_5_words = get_top_5_words(word_count)
    for word, count in top_5_words:
        print(f"{word}: {count}")

if __name__ == "__main__":
