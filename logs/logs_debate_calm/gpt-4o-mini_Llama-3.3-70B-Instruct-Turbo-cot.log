Here's a correct implementation:

```python
import os
from collections import Counter

def count_words_in_file(file_path):
    try:
        with open(file_path, 'r', encoding='utf-8') as file:
            text = file.read().lower()  # Convert to lowercase
            words = text.split()
            return Counter(words)
    except Exception as e:
        print(f"Error reading file {file_path}: {e}")
        return Counter()

def get_most_common_words(directory):
    total_word_counts = Counter()
    for root, dirs, files in os.walk(directory):
        for file in files:
            if file.endswith('.txt'):
                file_path = os.path.join(root, file)
                word_counts = count_words_in_file(file_path)
                total_word_counts += word_counts
    
    most_common_words = total_word_counts.most_common(5)
    return most_common_words

if __name__ == '__main__':
    directory = './'
    most_common_words = get_most_common_words(directory)
    for word, count in most_common_words:
        print(f'{word}: {count}')
```

