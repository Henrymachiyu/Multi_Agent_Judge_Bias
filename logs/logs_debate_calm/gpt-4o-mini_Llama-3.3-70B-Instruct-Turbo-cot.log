Here's a simple and effective way to achieve this in Python:

```python
import os
from collections import Counter
import re

def read_and_count_words(directory):
    word_counts = Counter()
    for root, dirs, files in os.walk(directory):
        for file in files:
            if file.endswith('.txt'):
                file_path = os.path.join(root, file)
                with open(file_path, 'r', encoding='utf-8') as f:
                    text = f.read().lower()
                    words = re.findall(r'\b\w+\b', text)
                    word_counts.update(words)
    return word_counts

def get_top_5_words(word_counts):
    return word_counts.most_common(5)

if __name__ == '__main__':
    directory = './'
    word_counts = read_and_count_words(directory)
    top_5_words = get_top_5_words(word_counts)
    for word, count in top_5_words:
        print(f'{word}: {count}')
```

This solution correctly aggregates word counts across all files, handles the conversion of text to lowercase to ensure accurate counting (regardless of case), and uses regular expressions to extract words from the text, which is more robust than simply splitting on whitespace.

