import csv
from datetime import datetime

# Initialize dictionary to store highest and lowest closing prices for each month
monthly_prices = {}

with open('stock_prices.csv', 'r') as file:
    reader = csv.reader(file)
    next(reader)  # Skip header row
    
    for row in reader:
        date = datetime.strptime(row[0], '%Y-%m-%d')
        month = date.month
        close_price = float(row[4])
        
        if month not in monthly_prices:
            monthly_prices[month] = {'highest': close_price, 'lowest': close_price}
        else:
            if close_price > monthly_prices[month]['highest']:
                monthly_prices[month]['highest'] = close_price
            if close_price < monthly_prices[month]['lowest']:
                monthly_prices[month]['lowest'] = close_price

# Output as CSV string
output = "Month,Highest Closing Price,Lowest Closing Price\n"
for month, prices in monthly_prices.items():
    output += f"{month},{prices['highest']},{prices['lowest']}\n"

