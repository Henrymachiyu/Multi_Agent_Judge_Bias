def find_median(a, b):
    merged = []
    pa, pb = 0, 0
    
    # Merge the two arrays
    while pa < len(a) and pb < len(b):
        if a[pa] < b[pb]:
            merged.append(a[pa])
            pa += 1
        else:
            merged.append(b[pb])
            pb += 1
    
