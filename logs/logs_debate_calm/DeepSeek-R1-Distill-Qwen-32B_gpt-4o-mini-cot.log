```python
def full_binary_trees(n):
    if n == 0:
        return 1
    B = [0] * (n + 1)
    B[0] = 1  # Base case
    for i in range(1, n + 1):
        for j in range(i):
            B[i] += B[j] * B[i - 1 - j]
    return B[n]
```

