def find_majority_element(arr):
    # Step 1: Find the candidate
    candidate = None
    count = 0
    
    for num in arr:
        if count == 0:
            candidate = num
            count = 1
        elif num == candidate:
            count += 1
        else:
            count -= 1
    
    # Step 2: Verify the candidate
    if candidate is not None:
        count = sum(1 for num in arr if num == candidate)
        if count > len(arr) // 2:
