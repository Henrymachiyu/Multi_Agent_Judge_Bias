        self.val = val
        self.left = None
        self.right = None

def find_highest_common_ancestor(root, node1, node2):
    if not root:
        return None  # If the root is None, then there is no tree to search.
    
    # If the current node is one of the nodes we are looking for
    if root == node1 or root == node2:
        return root
    
    # Recursively search the left and right subtrees
    left_hca = find_highest_common_ancestor(root.left, node1, node2)
    right_hca = find_highest_common_ancestor(root.right, node1, node2)
    
    # If both left and right calls return non-null, this node is the HCA
    if left_hca and right_hca:
        return root
    
    # Otherwise return the non-null child
    return left_hca if left_hca else right_hca
```

