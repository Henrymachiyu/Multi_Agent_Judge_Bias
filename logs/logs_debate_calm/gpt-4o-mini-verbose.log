def find_majority_element(arr):
    # Step 1: Find the candidate
    candidate = None
    count = 0
    
    for num in arr:
        if count == 0:
            candidate = num
            count = 1
        elif num == candidate:
            count += 1
        else:
            count -= 1
    
    # Step 2: Verify the candidate
    if arr.count(candidate) > len(arr) // 2:
        return candidate
    return None
```

