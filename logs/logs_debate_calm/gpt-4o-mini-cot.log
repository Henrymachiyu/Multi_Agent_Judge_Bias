```python
def find_majority_element(arr):
    candidate = None
    count = 0
    
    # First pass to find the candidate
    for num in arr:
        if count == 0:
            candidate = num
        count += (1 if num == candidate else -1)
    
    # Second pass to verify the candidate
    count = sum(1 for num in arr if num == candidate)
    if count > len(arr) // 2:
        return candidate
    return None
```

