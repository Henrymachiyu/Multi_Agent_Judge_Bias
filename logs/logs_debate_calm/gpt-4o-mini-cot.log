def find_median_sorted_arrays(a, b):
    m, n = len(a), len(b)
    total_length = m + n
    median_pos = total_length // 2

    i, j = 0, 0
    current = 0
    prev = 0

    for _ in range(m + n):
        prev = current
        if i < m and (j >= n or a[i] < b[j]):
            current = a[i]
            i += 1
        else:
            current = b[j]
            j += 1

        if i + j > median_pos:
            break

    if total_length % 2 == 0:
        return (current + prev) / 2
    else:
        return current
```

