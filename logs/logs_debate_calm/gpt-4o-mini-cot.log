        if i < n1 and (j >= n2 or arr1[i] < arr2[j]):
            current = arr1[i]
            i += 1
        else:
            current = arr2[j]
            j += 1

    if total_length % 2 == 0:
        return (prev + current) / 2
    else:
        return current
