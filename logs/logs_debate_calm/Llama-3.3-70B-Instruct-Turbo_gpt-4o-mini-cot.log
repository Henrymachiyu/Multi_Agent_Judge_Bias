Here’s a complete implementation:

```python
class TreeNode:
    def __init__(self, value):
        self.value = value
        self.left = None
        self.right = None

def find_hca(root, node1, node2):
    if root is None:
        return None
    
    # If either node1 or node2 matches the root, return root
    if root.value == node1 or root.value == node2:
        return root
    
    # Recur for left and right subtrees
    left_hca = find_hca(root.left, node1, node2)
    right_hca = find_hca(root.right, node1, node2)
    
    # If both left_hca and right_hca are not None, this root is the HCA
    if left_hca and right_hca:
        return root
    
    # Otherwise return the non-null child
    return left_hca if left_hca is not None else right_hca
```

