def find_median_sorted_arrays(a, b):
    total_length = len(a) + len(b)
    mid_index = total_length // 2
    i, j = 0, 0
    current = None
    prev = None

    for _ in range(mid_index + 1):
        prev = current
        if i < len(a) and (j >= len(b) or a[i] < b[j]):
            current = a[i]
            i += 1
        else:
            current = b[j]
            j += 1

    if total_length % 2 == 0:
        return (prev + current) / 2
    else:
        return current
```

