def find_majority_element(arr):
    count = 0
    candidate = None
    for num in arr:
        if count == 0:
            candidate = num
            count = 1
        elif candidate == num:
            count += 1
        else:
            count -= 1
    # Verify that the candidate occurs more than n/2 times
    if arr.count(candidate) > len(arr) / 2:
        return candidate
    else:
        return None
```

