        merged.append(b[j])
        j += 1
        
    # Calculate the total length of the merged array
    total_length = len(merged)
    
    # Calculate the median
    if total_length % 2 == 0:
        median = (merged[total_length // 2 - 1] + merged[total_length // 2]) / 2
    else:
        median = merged[total_length // 2]
        
    return median

