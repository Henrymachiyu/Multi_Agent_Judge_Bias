class Node:
    def __init__(self, value, left=None, right=None):
        self.value = value
        self.left = left
        self.right = right

def find_path(root, node):
    if root is None:
        return None
    if root == node:
        return [root]
    left_path = find_path(root.left, node)
    if left_path is not None:
        return [root] + left_path
    right_path = find_path(root.right, node)
    if right_path is not None:
        return [root] + right_path
    return None

def find_hca(root, node1, node2):
    path1 = find_path(root, node1)
    path2 = find_path(root, node2)
    if path1 is None or path2 is None:
        return None
    i = 0
    while i < len(path1) and i < len(path2) and path1[i] == path2[i]:
        i += 1
    return path1[i-1]

