def full_binary_trees(n):
    if n % 2 == 1:
        B = [0] * (n + 1)
        B[0] = 1
        for i in range(1, n + 1, 2):
            for k in range(i):
                if k % 2 == 1 and (i - 1 - k) % 2 == 1:
                    B[i] += B[k] * B[i - 1 - k]
