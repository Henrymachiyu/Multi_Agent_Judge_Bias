    current, previous = None, None
    
    for _ in range(half_length + 1):
        previous = current
        if pa < len(a) and (pb == len(b) or a[pa] < b[pb]):
            current = a[pa]
            pa += 1
        else:
            current = b[pb]
            pb += 1
    
    if total_length % 2 == 1:
        return current
    else:
        return (previous + current) / 2
```

