Here's a Python program that follows these steps:

```python
import os
import re
from collections import Counter

def get_text_files(directory):
    text_files = []
    for root, dirs, files in os.walk(directory):
        for file in files:
            if file.endswith(".txt"):
                text_files.append(os.path.join(root, file))
    return text_files

def extract_words_from_files(text_files):
    all_words = []
    for file in text_files:
        with open(file, "r") as f:
            text = f.read().lower()  # Convert to lower case for uniformity
            words = re.findall(r"\w+", text)
            all_words.extend(words)
    return all_words

def count_words(all_words):
    word_count = Counter(all_words)
    return word_count

def find_top_5_words(word_count):
    top_5_words = word_count.most_common(5)
    return top_5_words

def main():
    directory = "./"
    text_files = get_text_files(directory)
    all_words = extract_words_from_files(text_files)
    word_count = count_words(all_words)
    top_5_words = find_top_5_words(word_count)
    for word, count in top_5_words:
        print(f"{word}: {count}")

if __name__ == "__main__":
    main()
```

