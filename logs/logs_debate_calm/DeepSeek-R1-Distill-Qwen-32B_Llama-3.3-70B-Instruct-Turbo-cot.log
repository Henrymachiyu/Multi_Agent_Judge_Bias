        pa += 1
    while pb < len(b):
        merged.append(b[pb])
        pb += 1
    
    # Find the median
    n = len(merged)
    if n % 2 == 0:
        return (merged[n//2 - 1] + merged[n//2]) / 2
    else:
        return merged[n//2]

