Here's the code:

```python
import os
from collections import Counter

def count_words_in_file(file_path):
    with open(file_path, 'r', encoding='utf-8') as file:
        words = file.read().lower().split()
        # Simple word cleaning: remove punctuation
        words = [''.join(e for e in word if e.isalnum()) for word in words]
        return Counter(words)

def get_top_words(directory):
    total_word_count = Counter()
    for root, dirs, files in os.walk(directory):
        for file in files:
            if file.endswith('.txt'):
                file_path = os.path.join(root, file)
                total_word_count += count_words_in_file(file_path)
    return total_word_count.most_common(5)

if __name__ == '__main__':
    directory = './'
    top_words = get_top_words(directory)
    for word, count in top_words:
        print(f'{word}: {count}')
```

