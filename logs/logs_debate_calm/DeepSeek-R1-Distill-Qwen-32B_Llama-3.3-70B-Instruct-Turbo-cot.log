import os
from collections import Counter
import re

def count_words_in_file(file_path):
    with open(file_path, 'r', encoding='utf-8') as file:
        contents = file.read()
        words = re.findall(r'\b\w+\b', contents.lower())
        return Counter(words)

def get_top_5_words(directory):
    total_word_counts = Counter()
    for filename in os.listdir(directory):
        if filename.endswith(".txt"):
            file_path = os.path.join(directory, filename)
            word_counts = count_words_in_file(file_path)
            total_word_counts += word_counts
    return total_word_counts.most_common(5)

directory = './'
top_5_words = get_top_5_words(directory)
for word, count in top_5_words:
    print(f'{word}: {count}')
```

