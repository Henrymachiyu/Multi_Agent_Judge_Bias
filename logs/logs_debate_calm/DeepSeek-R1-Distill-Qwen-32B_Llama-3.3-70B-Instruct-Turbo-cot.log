```python
import os
from collections import Counter

def count_words_in_file(file_path):
    with open(file_path, 'r', encoding='utf-8') as file:
        words = file.read().lower().split()
        # Simple word cleaning, consider more complex cleaning for punctuation and special characters
        words = [word for word in words if word.isalpha()]
        return Counter(words)

def get_top_words(directory, top_n=5):
    total_word_counts = Counter()
    for root, dirs, files in os.walk(directory):
        for file in files:
            if file.endswith('.txt'):
                file_path = os.path.join(root, file)
                total_word_counts += count_words_in_file(file_path)
    
    return total_word_counts.most_common(top_n)

if __name__ == '__main__':
    directory = './'
    top_words = get_top_words(directory)
    for word, count in top_words:
        print(f'{word}: {count}')
```

