def find_majority_element(arr):
    # Initialize variables
    count = 0
    candidate = None
    
    # First pass to find the candidate for majority element
    for elem in arr:
        if count == 0:
            candidate = elem
            count = 1
        elif candidate == elem:
            count += 1
        else:
            count -= 1
    
    # Second pass to verify the candidate
    occurrences = sum(1 for elem in arr if elem == candidate)
    
    # Return the majority element if it occurs more than n/2 times
    return candidate if occurrences > len(arr) / 2 else None
```

