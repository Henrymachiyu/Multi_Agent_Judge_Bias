```python
def find_majority_element(arr):
    if not arr:
        return None
    
    # First pass: Find the candidate
    count = 0
    candidate = None
    for num in arr:
        if count == 0:
            candidate = num
            count = 1
        elif num == candidate:
            count += 1
        else:
            count -= 1
    
    # Second pass: Verify the candidate
    count = sum(1 for num in arr if num == candidate)
    return candidate if count > len(arr) / 2 else None
```

