Here's the Python code for the correct approach:
```python
def find_median(a, b):
    merged = []
    pa, pb = 0, 0
    
    # Merge the two arrays
    while pa < len(a) and pb < len(b):
        if a[pa] < b[pb]:
            merged.append(a[pa])
            pa += 1
        else:
            merged.append(b[pb])
            pb += 1
    
    # Append the remaining elements
    while pa < len(a):
        merged.append(a[pa])
        pa += 1
    while pb < len(b):
        merged.append(b[pb])
        pb += 1
    
    # Find the median
    n = len(merged)
    if n % 2 == 0:
        return (merged[n//2 - 1] + merged[n//2]) / 2
    else:
        return merged[n//2]

