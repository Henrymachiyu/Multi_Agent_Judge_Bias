```python
class Node:
    def __init__(self, value):
        self.value = value
        self.left = None
        self.right = None

def find_path(root, node, path=[]):
    if not root:
        return False
    path.append(root)
    if root == node:
        return True
    if (root.left and find_path(root.left, node, path)) or (root.right and find_path(root.right, node, path)):
        return True
    path.pop()
    return False

def find_lca(root, node1, node2):
